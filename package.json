{
  "name": "next-gen",
  "version": "0.2.0",
  "private": true,
  "description": "NEXT GEN by THE TECH HUB: study library, practice and mock tests for IITM BS Foundation students",
  "scripts": {
    "dev": "npm run tokens && next dev",
    "dev:demo": "node scripts/dev-demo.mjs",
    "build": "node scripts/build-tokens.mjs --check && node scripts/lint-tokens.mjs && node scripts/validate-content.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/build-tokens.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "validate:content": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.4.4",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
