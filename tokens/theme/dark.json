{
  "$description": "Dark theme: overrides for semantic colour tokens, applied under html[data-theme=\"dark\"]. Same names as tokens/semantic/color.json; values alias primitives. Tokens not listed keep their light value. Every subject's soft colour is derived automatically (a tint of its solid colour on the dark surface), so subjects don't need entries here.",
  "color": {
    "bg": {
      "canvas": { "$value": "{color.night.950}" },
      "surface": { "$value": "{color.night.900}" },
      "subtle": { "$value": "{color.night.875}" },
      "sunken": { "$value": "{color.night.925}" },
      "hover": { "$value": "{color.night.875}" },
      "topbar": { "$value": "{color.alpha.night-950-88}" },
      "scrim": { "$value": "{color.alpha.black-60}" }
    },
    "text": {
      "primary": { "$value": "{color.night.100}" },
      "body": { "$value": "{color.night.200}" },
      "secondary": { "$value": "{color.night.300}" },
      "muted": { "$value": "{color.night.400}" },
      "disabled": { "$value": "{color.night.500}" },
      "link": { "$value": "{color.indigo.400}" }
    },
    "border": {
      "default": { "$value": "{color.night.800}" },
      "strong": { "$value": "{color.night.700}" },
      "focus": { "$value": "{color.alpha.indigo-400-50}" }
    },
    "accent": {
      "solid": { "$value": "{color.indigo.500}" },
      "strong": { "$value": "{color.indigo.300}" },
      "soft": { "$value": "{color.indigo.900}" },
      "softer": { "$value": "{color.indigo.950}" },
      "border": { "$value": "{color.indigo.750}" },
      "on-soft": { "$value": "{color.indigo.300}" }
    },
    "action": {
      "primary": {
        "bg": { "$value": "{color.teal.400}" },
        "bg-hover": { "$value": "{color.teal.500}" }
      }
    },
    "success": {
      "solid": { "$value": "{color.teal.400}" },
      "bg": { "$value": "{color.teal.900}" },
      "soft": { "$value": "{color.teal.850}" },
      "border": { "$value": "{color.teal.750}" },
      "fg": { "$value": "{color.teal.300}" },
      "fg-strong": { "$value": "{color.teal.200}" },
      "text": { "$value": "{color.green.400}" }
    },
    "danger": {
      "solid": { "$value": "{color.red.400}" },
      "bg": { "$value": "{color.red.900}" },
      "soft": { "$value": "{color.red.850}" },
      "border": { "$value": "{color.red.750}" },
      "fg": { "$value": "{color.red.300}" },
      "fg-strong": { "$value": "{color.red.150}" },
      "divider": { "$value": "{color.alpha.red-300-15}" }
    },
    "warning": {
      "bg": { "$value": "{color.amber.900}" },
      "border": { "$value": "{color.amber.750}" },
      "fg": { "$value": "{color.amber.300}" },
      "fg-strong": { "$value": "{color.amber.150}" }
    },
    "info": {
      "bg": { "$value": "{color.indigo.900}" },
      "fg": { "$value": "{color.indigo.300}" },
      "fg-strong": { "$value": "{color.indigo.200}" }
    },
    "nav": {
      "bg": { "$value": "{color.night.925}" },
      "bg-hover": { "$value": "{color.night.875}" },
      "bg-active": { "$value": "{color.indigo.900}" },
      "bg-raised": { "$value": "{color.night.900}" },
      "border": { "$value": "{color.night.800}" },
      "border-strong": { "$value": "{color.night.700}" },
      "text": { "$value": "{color.night.300}" },
      "text-strong": { "$value": "{color.night.100}" },
      "text-active": { "$value": "{color.indigo.200}" },
      "text-soft": { "$value": "{color.night.200}" },
      "text-muted": { "$value": "{color.night.400}" },
      "text-faint": { "$value": "{color.night.400}" },
      "indicator": { "$value": "{color.teal.400}" },
      "status": { "$value": "{color.teal.400}" }
    },
    "selected": {
      "bg": { "$value": "{color.night.100}" },
      "fg": { "$value": "{color.night.950}" }
    },
    "feature": {
      "start": { "$value": "{color.royal.800}" },
      "end": { "$value": "{color.royal.600}" }
    },
    "explain": {
      "divider": { "$value": "{color.alpha.teal-300-20}" }
    },
    "category": {
      "1-bg": { "$value": "{color.indigo.900}" },
      "1-fg": { "$value": "{color.indigo.300}" },
      "2-bg": { "$value": "{color.teal.900}" },
      "2-fg": { "$value": "{color.teal.300}" },
      "3-bg": { "$value": "{color.amber.900}" },
      "3-fg": { "$value": "{color.amber.300}" },
      "4-bg": { "$value": "{color.violet.900}" },
      "4-fg": { "$value": "{color.violet.300}" }
    },
    "shadow": {
      "raised": { "$value": "{color.alpha.black-40}" },
      "overlay": { "$value": "{color.alpha.black-60}" }
    }
  }
}
