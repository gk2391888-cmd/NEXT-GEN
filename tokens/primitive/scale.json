{
  "$description": "Tier 1 · Primitive scales: spacing, sizes, radii, type, motion, layers and breakpoints. Raw values only; components use the semantic and component tiers.",
  "space": {
    "$type": "dimension",
    "$description": "4px grid, named in hundredths of 8px (100 = 8px), as in Atlassian's spacing scale.",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "025": { "$value": { "value": 2, "unit": "px" } },
    "050": { "$value": { "value": 4, "unit": "px" } },
    "075": { "$value": { "value": 6, "unit": "px" } },
    "100": { "$value": { "value": 8, "unit": "px" } },
    "125": { "$value": { "value": 10, "unit": "px" } },
    "150": { "$value": { "value": 12, "unit": "px" } },
    "175": { "$value": { "value": 14, "unit": "px" } },
    "200": { "$value": { "value": 16, "unit": "px" } },
    "250": { "$value": { "value": 20, "unit": "px" } },
    "300": { "$value": { "value": 24, "unit": "px" } },
    "350": { "$value": { "value": 28, "unit": "px" } },
    "400": { "$value": { "value": 32, "unit": "px" } },
    "500": { "$value": { "value": 40, "unit": "px" } },
    "600": { "$value": { "value": 48, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "$description": "Fixed sizes for icons, avatars and controls.",
    "100": { "$value": { "value": 8, "unit": "px" } },
    "150": { "$value": { "value": 12, "unit": "px" } },
    "250": { "$value": { "value": 20, "unit": "px" } },
    "300": { "$value": { "value": 24, "unit": "px" } },
    "350": { "$value": { "value": 28, "unit": "px" } },
    "400": { "$value": { "value": 32, "unit": "px" } },
    "450": { "$value": { "value": 36, "unit": "px" } },
    "500": { "$value": { "value": 40, "unit": "px" } },
    "550": { "$value": { "value": 44, "unit": "px" } },
    "700": { "$value": { "value": 56, "unit": "px" } },
    "1000": { "$value": { "value": 80, "unit": "px" } },
    "1500": { "$value": { "value": 120, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 6, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "lg": { "$value": { "value": 10, "unit": "px" } },
    "xl": { "$value": { "value": 12, "unit": "px" } },
    "2xl": { "$value": { "value": 14, "unit": "px" } },
    "3xl": { "$value": { "value": 20, "unit": "px" } },
    "4xl": { "$value": { "value": 24, "unit": "px" } },
    "pill": { "$value": { "value": 999, "unit": "px" } }
  },
  "border-width": {
    "$type": "dimension",
    "thin": { "$value": { "value": 1, "unit": "px" } },
    "thick": { "$value": { "value": 1.5, "unit": "px" } },
    "heavy": { "$value": { "value": 2, "unit": "px" } },
    "focus": { "$value": { "value": 3, "unit": "px" } }
  },
  "font-family": {
    "$type": "fontFamily",
    "sans": { "$value": ["var(--font-dm-sans)", "DM Sans", "system-ui", "sans-serif"] },
    "display": { "$value": ["var(--font-jakarta)", "Plus Jakarta Sans", "var(--font-dm-sans)", "system-ui", "sans-serif"] },
    "mono": { "$value": ["ui-monospace", "Cascadia Code", "Consolas", "monospace"] }
  },
  "font-size": {
    "$type": "dimension",
    "$description": "rem, so text follows the browser's font-size setting (1rem = 16px by default).",
    "100": { "$value": { "value": 0.6875, "unit": "rem" }, "$description": "11px" },
    "150": { "$value": { "value": 0.75, "unit": "rem" }, "$description": "12px" },
    "200": { "$value": { "value": 0.8125, "unit": "rem" }, "$description": "13px" },
    "300": { "$value": { "value": 0.875, "unit": "rem" }, "$description": "14px" },
    "350": { "$value": { "value": 0.9375, "unit": "rem" }, "$description": "15px" },
    "400": { "$value": { "value": 1, "unit": "rem" }, "$description": "16px" },
    "450": { "$value": { "value": 1.0625, "unit": "rem" }, "$description": "17px" },
    "500": { "$value": { "value": 1.25, "unit": "rem" }, "$description": "20px" },
    "600": { "$value": { "value": 1.5, "unit": "rem" }, "$description": "24px" },
    "700": { "$value": { "value": 1.75, "unit": "rem" }, "$description": "28px" },
    "800": { "$value": { "value": 2, "unit": "rem" }, "$description": "32px" },
    "900": { "$value": { "value": 2.75, "unit": "rem" }, "$description": "44px" }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700 },
    "extrabold": { "$value": 800 }
  },
  "line-height": {
    "$type": "number",
    "tight": { "$value": 1.2 },
    "snug": { "$value": 1.35 },
    "normal": { "$value": 1.6 }
  },
  "letter-spacing": {
    "$type": "dimension",
    "tight": { "$value": { "value": -0.02, "unit": "em" } },
    "normal": { "$value": { "value": 0, "unit": "em" } },
    "wide": { "$value": { "value": 0.04, "unit": "em" } },
    "caps": { "$value": { "value": 0.1, "unit": "em" } },
    "eyebrow": { "$value": { "value": 0.16, "unit": "em" } }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": { "value": 120, "unit": "ms" } },
    "base": { "$value": { "value": 150, "unit": "ms" } },
    "slow": { "$value": { "value": 200, "unit": "ms" } },
    "slower": { "$value": { "value": 300, "unit": "ms" } }
  },
  "z": {
    "$type": "number",
    "sticky": { "$value": 20 },
    "scrim": { "$value": 25 },
    "drawer": { "$value": 30 },
    "dropdown": { "$value": 40 },
    "modal": { "$value": 60 }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Max-width breakpoints. CSS can't read variables inside @media, so these are the only values `npm run lint:tokens` allows in media queries.",
    "phone": { "$value": { "value": 600, "unit": "px" } },
    "tablet": { "$value": { "value": 900, "unit": "px" } },
    "laptop": { "$value": { "value": 1100, "unit": "px" } }
  }
}
