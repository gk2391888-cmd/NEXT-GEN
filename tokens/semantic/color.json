{
  "$description": "Tier 2 · Semantic colours, named by purpose. These are what pages and components use. To retheme (e.g. dark mode), point these at different primitives; nothing else changes.",
  "color": {
    "$type": "color",
    "bg": {
      "canvas": { "$value": "{color.slate.50}", "$description": "Page background." },
      "surface": { "$value": "{color.white}", "$description": "Cards, inputs, menus." },
      "subtle": { "$value": "{color.slate.150}", "$description": "Tracks, inactive keys, neutral chips." },
      "sunken": { "$value": "{color.slate.100}", "$description": "Code and worked-example panels." },
      "hover": { "$value": "{color.slate.50}", "$description": "Row and menu item hover." },
      "topbar": { "$value": "{color.alpha.slate-50-92}", "$description": "Translucent sticky header." },
      "scrim": { "$value": "{color.alpha.scrim-50}", "$description": "Behind modals and the mobile drawer." }
    },
    "text": {
      "primary": { "$value": "{color.slate.900}", "$description": "Headings, key values." },
      "body": { "$value": "{color.slate.700}", "$description": "Long-form text, list items." },
      "secondary": { "$value": "{color.slate.600}", "$description": "Paragraph copy under headings." },
      "muted": { "$value": "{color.slate.500}", "$description": "Captions, meta text, labels." },
      "disabled": { "$value": "{color.slate.400}" },
      "inverse": { "$value": "{color.white}", "$description": "Text on dark or solid backgrounds." },
      "inverse-muted": { "$value": "{color.navy.200}" },
      "link": { "$value": "{color.indigo.500}" }
    },
    "border": {
      "default": { "$value": "{color.slate.200}" },
      "strong": { "$value": "{color.slate.300}", "$description": "Hover state for bordered controls." },
      "focus": { "$value": "{color.alpha.indigo-500-45}", "$description": "Keyboard focus ring." }
    },
    "accent": {
      "$description": "Indigo: selection, current item, links, info.",
      "solid": { "$value": "{color.indigo.500}" },
      "strong": { "$value": "{color.indigo.600}" },
      "soft": { "$value": "{color.indigo.100}" },
      "softer": { "$value": "{color.indigo.50}" },
      "border": { "$value": "{color.indigo.300}" },
      "on-soft": { "$value": "{color.indigo.600}", "$description": "Text on accent.soft." }
    },
    "action": {
      "primary": {
        "bg": { "$value": "{color.teal.500}" },
        "bg-hover": { "$value": "{color.teal.600}" },
        "fg": { "$value": "{color.teal.950}" }
      }
    },
    "success": {
      "solid": { "$value": "{color.teal.500}" },
      "bg": { "$value": "{color.teal.50}" },
      "soft": { "$value": "{color.teal.100}" },
      "border": { "$value": "{color.teal.200}" },
      "fg": { "$value": "{color.teal.700}" },
      "fg-strong": { "$value": "{color.teal.800}" },
      "text": { "$value": "{color.green.600}", "$description": "A good score shown as text." }
    },
    "danger": {
      "solid": { "$value": "{color.red.500}" },
      "bg": { "$value": "{color.red.50}" },
      "soft": { "$value": "{color.red.100}" },
      "border": { "$value": "{color.red.200}" },
      "fg": { "$value": "{color.red.700}" },
      "fg-strong": { "$value": "{color.red.800}" },
      "divider": { "$value": "{color.alpha.red-800-15}" },
      "emphasis": { "$value": "{color.red.700}", "$description": "Background of filled destructive buttons, under white text. Same in both themes." },
      "emphasis-hover": { "$value": "{color.red.800}" }
    },
    "warning": {
      "solid": { "$value": "{color.amber.400}" },
      "bg": { "$value": "{color.amber.50}" },
      "border": { "$value": "{color.amber.200}" },
      "fg": { "$value": "{color.amber.700}" },
      "fg-strong": { "$value": "{color.amber.800}" }
    },
    "info": {
      "bg": { "$value": "{color.indigo.100}" },
      "fg": { "$value": "{color.indigo.700}" },
      "fg-strong": { "$value": "{color.indigo.800}" }
    },
    "nav": {
      "$description": "The sidebar: white in the light theme, deep navy in the dark theme (tokens/theme/dark.json).",
      "bg": { "$value": "{color.white}" },
      "bg-hover": { "$value": "{color.slate.50}" },
      "bg-active": { "$value": "{color.indigo.100}" },
      "bg-raised": { "$value": "{color.slate.100}" },
      "border": { "$value": "{color.slate.200}" },
      "border-strong": { "$value": "{color.slate.300}" },
      "text": { "$value": "{color.slate.600}" },
      "text-strong": { "$value": "{color.slate.900}" },
      "text-active": { "$value": "{color.indigo.600}", "$description": "The current page in the sidebar." },
      "text-soft": { "$value": "{color.slate.700}" },
      "text-muted": { "$value": "{color.slate.500}" },
      "text-faint": { "$value": "{color.slate.500}" },
      "indicator": { "$value": "{color.indigo.500}" },
      "status": { "$value": "{color.teal.500}" }
    },
    "selected": {
      "$description": "The chosen option in a row of filter pills: a solid, high-contrast pill.",
      "bg": { "$value": "{color.slate.900}" },
      "fg": { "$value": "{color.white}" }
    },
    "feature": {
      "$description": "The \"Continue where you left off\" card on the Overview.",
      "start": { "$value": "{color.indigo.500}" },
      "end": { "$value": "{color.violet.600}" }
    },
    "brand": {
      "gradient-start": { "$value": "{color.cyan.300}", "$description": "Logo mark gradient." },
      "gradient-end": { "$value": "{color.violet.600}" },
      "hero-start": { "$value": "{color.navy.900}", "$description": "Dark hero, login and Pro card gradient." },
      "hero-mid": { "$value": "{color.royal.700}" },
      "hero-end": { "$value": "{color.royal.600}" },
      "hero-label": { "$value": "{color.teal.300}" },
      "hero-label-bg": { "$value": "{color.alpha.teal-400-12}" },
      "glass": { "$value": "{color.alpha.white-8}", "$description": "Secondary button on dark backgrounds." },
      "glass-border": { "$value": "{color.alpha.white-20}" },
      "glow-start": { "$value": "{color.alpha.cyan-300-25}" },
      "glow-end": { "$value": "{color.alpha.violet-600-5}" },
      "google": { "$value": "{color.google-blue}" }
    },
    "code": {
      "editor-bg": { "$value": "{color.code.bg}" },
      "editor-fg": { "$value": "{color.code.fg}" },
      "editor-focus": { "$value": "{color.alpha.indigo-500-60}" }
    },
    "explain": {
      "divider": { "$value": "{color.alpha.teal-800-20}" }
    },
    "category": {
      "$description": "Decorative tints for icon tiles (Overview metrics). Not for status.",
      "1-bg": { "$value": "{color.indigo.100}" },
      "1-fg": { "$value": "{color.indigo.500}" },
      "2-bg": { "$value": "{color.teal.100}" },
      "2-fg": { "$value": "{color.teal.700}" },
      "3-bg": { "$value": "{color.amber.50}" },
      "3-fg": { "$value": "{color.amber.700}" },
      "4-bg": { "$value": "{color.violet.100}" },
      "4-fg": { "$value": "{color.violet.500}" }
    },
    "shadow": {
      "raised": { "$value": "{color.alpha.shadow-14}" },
      "overlay": { "$value": "{color.alpha.scrim-30}" }
    }
  }
}
