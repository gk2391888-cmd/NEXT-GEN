{
  "$description": "Tier 2 · Semantic type, spacing, layout, elevation and motion. Pages and components use these names, never raw sizes.",
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": { "$value": "{font-family.sans}" },
      "heading": { "$value": "{font-family.display}" },
      "code": { "$value": "{font-family.mono}" }
    },
    "size": {
      "$type": "dimension",
      "caption": { "$value": "{font-size.100}", "$description": "11px · eyebrows, chips, table headers, tags." },
      "meta": { "$value": "{font-size.150}", "$description": "12px · labels, helper and muted text." },
      "small": { "$value": "{font-size.200}", "$description": "13px · secondary text, buttons, tables." },
      "body": { "$value": "{font-size.300}", "$description": "14px · default text." },
      "title-sm": { "$value": "{font-size.350}", "$description": "15px · h3, card titles." },
      "title-md": { "$value": "{font-size.450}", "$description": "17px · question text, section headings." },
      "title-lg": { "$value": "{font-size.500}", "$description": "20px · h2." },
      "display-sm": { "$value": "{font-size.600}", "$description": "24px · stat values, timer, mobile h1." },
      "display-md": { "$value": "{font-size.700}", "$description": "28px · page h1." },
      "display-lg": { "$value": "{font-size.800}", "$description": "32px · hero h1, price." },
      "display-xl": { "$value": "{font-size.900}", "$description": "44px · result score." }
    },
    "weight": {
      "$type": "fontWeight",
      "body": { "$value": "{font-weight.regular}" },
      "medium": { "$value": "{font-weight.medium}" },
      "strong": { "$value": "{font-weight.semibold}" },
      "bold": { "$value": "{font-weight.bold}" },
      "heading": { "$value": "{font-weight.extrabold}" }
    },
    "line-height": {
      "$type": "number",
      "heading": { "$value": "{line-height.tight}" },
      "snug": { "$value": "{line-height.snug}" },
      "body": { "$value": "{line-height.normal}" }
    },
    "tracking": {
      "$type": "dimension",
      "heading": { "$value": "{letter-spacing.tight}" },
      "normal": { "$value": "{letter-spacing.normal}" },
      "wide": { "$value": "{letter-spacing.wide}" },
      "caps": { "$value": "{letter-spacing.caps}", "$description": "Uppercase labels and breadcrumbs." },
      "eyebrow": { "$value": "{letter-spacing.eyebrow}", "$description": "Small uppercase section eyebrows." }
    }
  },
  "space": {
    "$type": "dimension",
    "xxs": { "$value": "{space.025}" },
    "xs": { "$value": "{space.050}" },
    "sm": { "$value": "{space.100}" },
    "md": { "$value": "{space.150}" },
    "lg": { "$value": "{space.200}" },
    "xl": { "$value": "{space.300}" },
    "2xl": { "$value": "{space.400}" },
    "3xl": { "$value": "{space.600}" },
    "inline": {
      "$description": "Gaps between items in a row.",
      "tight": { "$value": "{space.075}" },
      "default": { "$value": "{space.125}" },
      "loose": { "$value": "{space.150}" }
    },
    "stack": {
      "$description": "Vertical gaps between stacked blocks.",
      "tight": { "$value": "{space.100}" },
      "default": { "$value": "{space.150}" },
      "loose": { "$value": "{space.200}" },
      "section": { "$value": "{space.400}" }
    },
    "inset": {
      "$description": "Padding inside containers.",
      "tight": { "$value": "{space.125}" },
      "default": { "$value": "{space.200}" },
      "loose": { "$value": "{space.300}" }
    },
    "grid-gap": { "$value": "{space.200}" },
    "page-gutter": { "$value": "{space.400}", "$description": "Left/right page padding on desktop." },
    "page-gutter-compact": { "$value": "{space.200}", "$description": "Left/right page padding on tablet and phone." }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": "{radius.lg}", "$description": "Buttons, selects." },
    "field": { "$value": "{radius.xl}", "$description": "Text inputs, answer options." },
    "chip": { "$value": "{radius.sm}" },
    "key": { "$value": "{radius.md}", "$description": "Answer-option letters, palette buttons." },
    "tail": { "$value": "{radius.xs}", "$description": "Chat bubble tail corner, legend swatches." },
    "tile": { "$value": "{radius.lg}", "$description": "Icon tiles, small panels." },
    "panel": { "$value": "{radius.xl}", "$description": "Alerts, callouts, review items." },
    "card": { "$value": "{radius.2xl}" },
    "feature": { "$value": "{radius.3xl}", "$description": "Hero banner." },
    "round": { "$value": "{radius.pill}" }
  },
  "size": {
    "$type": "dimension",
    "$description": "Fixed sizes of icons, tiles and marks.",
    "dot": { "$value": "{size.100}", "$description": "8px · status light, progress bar height." },
    "swatch": { "$value": "{size.150}", "$description": "12px · legend swatches." },
    "icon-sm": { "$value": "{size.300}", "$description": "24px · nav icons, week dots, section numbers." },
    "icon-md": { "$value": "{size.350}", "$description": "28px · answer keys, small subject icons." },
    "icon-lg": { "$value": "{size.450}", "$description": "36px · metric and action tiles." },
    "icon-xl": { "$value": "{size.550}", "$description": "44px · subject icons." },
    "logo": { "$value": "{size.500}", "$description": "40px · logo mark, large avatar." },
    "date": { "$value": "{size.700}", "$description": "56px · planner date tile." },
    "logo-hero": { "$value": "{size.1000}" },
    "hero-art": { "$value": "{size.1500}" }
  },
  "layout": {
    "$type": "dimension",
    "sidebar-width": { "$value": { "value": 240, "unit": "px" } },
    "side-panel-width": { "$value": { "value": 272, "unit": "px" }, "$description": "Week list, test palette, Coding Lab tests." },
    "topbar-height": { "$value": { "value": 64, "unit": "px" } },
    "content-max": { "$value": { "value": 1240, "unit": "px" } },
    "wide-max": { "$value": { "value": 880, "unit": "px" }, "$description": "Pricing and formula sheets." },
    "reading-max": { "$value": { "value": 780, "unit": "px" }, "$description": "Quizzes, legal pages, long forms." },
    "form-max": { "$value": { "value": 560, "unit": "px" }, "$description": "Short forms and empty states." },
    "dialog-max": { "$value": { "value": 440, "unit": "px" } },
    "auth-max": { "$value": { "value": 400, "unit": "px" } },
    "menu-width": { "$value": { "value": 260, "unit": "px" } }
  },
  "control": {
    "$type": "dimension",
    "height-sm": { "$value": "{size.400}", "$description": "32px · compact buttons." },
    "height-md": { "$value": "{size.500}", "$description": "40px · default buttons and inputs." },
    "height-lg": { "$value": "{size.550}", "$description": "44px · primary actions; the minimum touch target." }
  },
  "border": {
    "$type": "dimension",
    "width": {
      "default": { "$value": "{border-width.thin}" },
      "emphasis": { "$value": "{border-width.thick}" },
      "selected": { "$value": "{border-width.heavy}" },
      "focus": { "$value": "{border-width.focus}" }
    }
  },
  "motion": {
    "$type": "duration",
    "fast": { "$value": "{duration.fast}" },
    "base": { "$value": "{duration.base}" },
    "slow": { "$value": "{duration.slow}" },
    "progress": { "$value": "{duration.slower}" }
  },
  "layer": {
    "$type": "number",
    "topbar": { "$value": "{z.sticky}" },
    "scrim": { "$value": "{z.scrim}" },
    "drawer": { "$value": "{z.drawer}" },
    "dropdown": { "$value": "{z.dropdown}" },
    "modal": { "$value": "{z.modal}" }
  },
  "shadow": {
    "$type": "shadow",
    "raised": { "$value": { "color": "{color.shadow.raised}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 14, "unit": "px" }, "blur": { "value": 40, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }, "$description": "Dropdown menus." },
    "overlay": { "$value": { "color": "{color.shadow.overlay}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 20, "unit": "px" }, "blur": { "value": 60, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }, "$description": "Modals and the open mobile drawer." }
  }
}
