{
  "$description": "Tier 3 · Component tokens. Each references a semantic token, so a component can be tuned on its own without touching the rest of the system.",
  "button": {
    "height": { "$type": "dimension", "$value": "{control.height-md}" },
    "height-lg": { "$type": "dimension", "$value": "{control.height-lg}" },
    "padding-x": { "$type": "dimension", "$value": "{space.lg}" },
    "gap": { "$type": "dimension", "$value": "{space.inline.tight}" },
    "radius": { "$type": "dimension", "$value": "{radius.control}" },
    "font-size": { "$type": "dimension", "$value": "{font.size.small}" },
    "font-weight": { "$type": "fontWeight", "$value": "{font.weight.bold}" },
    "primary-bg": { "$type": "color", "$value": "{color.action.primary.bg}" },
    "primary-bg-hover": { "$type": "color", "$value": "{color.action.primary.bg-hover}" },
    "primary-fg": { "$type": "color", "$value": "{color.action.primary.fg}" },
    "secondary-bg": { "$type": "color", "$value": "{color.bg.surface}" },
    "secondary-border": { "$type": "color", "$value": "{color.border.default}" },
    "secondary-border-hover": { "$type": "color", "$value": "{color.border.strong}" },
    "secondary-fg": { "$type": "color", "$value": "{color.text.primary}" },
    "danger-fg": { "$type": "color", "$value": "{color.danger.fg}" },
    "danger-border": { "$type": "color", "$value": "{color.danger.border}" },
    "danger-bg-hover": { "$type": "color", "$value": "{color.danger.soft}" }
  },
  "card": {
    "bg": { "$type": "color", "$value": "{color.bg.surface}" },
    "border": { "$type": "color", "$value": "{color.border.default}" },
    "radius": { "$type": "dimension", "$value": "{radius.card}" },
    "padding": { "$type": "dimension", "$value": "{space.inset.default}" },
    "padding-loose": { "$type": "dimension", "$value": "{space.inset.loose}" }
  },
  "input": {
    "height": { "$type": "dimension", "$value": "{control.height-lg}" },
    "padding-x": { "$type": "dimension", "$value": "{space.md}" },
    "radius": { "$type": "dimension", "$value": "{radius.field}" },
    "bg": { "$type": "color", "$value": "{color.bg.surface}" },
    "border": { "$type": "color", "$value": "{color.border.default}" },
    "border-focus": { "$type": "color", "$value": "{color.accent.solid}" }
  },
  "chip": {
    "radius": { "$type": "dimension", "$value": "{radius.chip}" },
    "font-size": { "$type": "dimension", "$value": "{font.size.caption}" },
    "padding-y": { "$type": "dimension", "$value": "{space.xxs}" },
    "padding-x": { "$type": "dimension", "$value": "{space.sm}" }
  },
  "option": {
    "radius": { "$type": "dimension", "$value": "{radius.field}" },
    "border": { "$type": "color", "$value": "{color.border.default}" },
    "border-hover": { "$type": "color", "$value": "{color.accent.border}" },
    "selected-border": { "$type": "color", "$value": "{color.accent.solid}" },
    "selected-bg": { "$type": "color", "$value": "{color.accent.softer}" },
    "right-border": { "$type": "color", "$value": "{color.success.border}" },
    "right-bg": { "$type": "color", "$value": "{color.success.bg}" },
    "wrong-border": { "$type": "color", "$value": "{color.danger.border}" },
    "wrong-bg": { "$type": "color", "$value": "{color.danger.bg}" }
  },
  "sidebar": {
    "width": { "$type": "dimension", "$value": "{layout.sidebar-width}" },
    "item-radius": { "$type": "dimension", "$value": "{radius.control}" }
  }
}
